@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:mod-cookbook:nhe-ouraverb-stereo#preset-fjord-under-sail>
    a pset:Preset ;
    lv2:appliesTo <urn:mod-cookbook:nhe-ouraverb-stereo> ;
    rdfs:label "Fjord Under Sail" ;
    lv2:port [ lv2:symbol "place" ; pset:value 0 ] ,
        [ lv2:symbol "expanse" ; pset:value 100 ] ,
        [ lv2:symbol "surface" ; pset:value 9 ] ,
        [ lv2:symbol "air" ; pset:value 6 ] ,
        [ lv2:symbol "bounce" ; pset:value 6 ] ,
        [ lv2:symbol "cover" ; pset:value 70 ] ,
        [ lv2:symbol "cover_density" ; pset:value 2 ] ,
        [ lv2:symbol "cover_height" ; pset:value 20 ] .

